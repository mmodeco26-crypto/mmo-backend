{
	"info": {
		"_postman_id": "moto-delivery-api-v2",
		"name": "🏍️ Moto Delivery Platform - Full API v2",
		"description": "مجموعة طلبات Postman المتكاملة تشمل: Auth, Orders, Drivers, PostGIS, WebSockets, Wallet & Commission, Reviews, and Admin Analytics",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "clientToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "driverToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "",
			"type": "string"
		},
		{
			"key": "driverUserId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login Admin (01000000000)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('adminToken', jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"01000000000\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login Client (01011111111)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('clientToken', jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"01011111111\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login Driver (01022222221)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('driverToken', jsonData.data.access_token);",
									"        pm.collectionVariables.set('driverUserId', jsonData.data.user.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"01022222221\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Orders & Concurrency",
			"item": [
				{
					"name": "Create Order by Client",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('orderId', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pickup_address\": \"البريد المركزي، الجزائر العاصمة\",\n  \"pickup_lat\": 36.7712,\n  \"pickup_lng\": 3.0588,\n  \"dropoff_address\": \"حي باب الزوار، الجزائر\",\n  \"dropoff_lat\": 36.7214,\n  \"dropoff_lng\": 3.1824,\n  \"notes\": \"يرجى الاتصال عند الوصول - الطابق 2\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						}
					}
				},
				{
					"name": "Get Nearby Orders (Driver)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{driverToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/orders/nearby?radius=15",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "nearby"],
							"query": [
								{
									"key": "radius",
									"value": "15"
								}
							]
						}
					}
				},
				{
					"name": "Accept Order (Driver - Concurrency Lock)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{driverToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}/accept",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "{{orderId}}", "accept"]
						}
					}
				},
				{
					"name": "Update Status: Delivered (Triggers 15% Commission)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{driverToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"delivered\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "{{orderId}}", "status"]
						}
					}
				}
			]
		},
		{
			"name": "3. Wallet & Commission",
			"item": [
				{
					"name": "Get Driver Wallet Balance",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{driverToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/wallet/me",
							"host": ["{{baseUrl}}"],
							"path": ["wallet", "me"]
						}
					}
				},
				{
					"name": "Get Wallet Transactions",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{driverToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/wallet/transactions",
							"host": ["{{baseUrl}}"],
							"path": ["wallet", "transactions"]
						}
					}
				},
				{
					"name": "Top Up Driver Wallet",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{driverToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 1500,\n  \"reference\": \"BaridiMob TXN-998811\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/wallet/top-up",
							"host": ["{{baseUrl}}"],
							"path": ["wallet", "top-up"]
						}
					}
				}
			]
		},
		{
			"name": "4. Reviews & Ratings",
			"item": [
				{
					"name": "Submit Order Review",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"order_id\": \"{{orderId}}\",\n  \"rating\": 5,\n  \"comment\": \"سائق محترف وسريع في التوصيل، شكراً جزيلاً!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/reviews",
							"host": ["{{baseUrl}}"],
							"path": ["reviews"]
						}
					}
				},
				{
					"name": "Get User Reviews",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/reviews/user/{{driverUserId}}",
							"host": ["{{baseUrl}}"],
							"path": ["reviews", "user", "{{driverUserId}}"]
						}
					}
				}
			]
		},
		{
			"name": "5. Admin Dashboard",
			"item": [
				{
					"name": "Get Live Platform Analytics",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/analytics",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "analytics"]
						}
					}
				},
				{
					"name": "Get Pending KYC Drivers",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/drivers/kyc-pending",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "drivers", "kyc-pending"]
						}
					}
				},
				{
					"name": "Get All Drivers with Debt Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/drivers",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "drivers"]
						}
					}
				}
			]
		}
	]
}
